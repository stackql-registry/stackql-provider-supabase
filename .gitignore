# The downloaded spec snapshot in provider-dev/downloaded/ IS committed:
# the Supabase Management API serves a single unversioned spec
# (https://api.supabase.com/api/v1-json) and the vendor ships fast, so
# committing the snapshot makes every refresh a reviewable diff against the
# hash pin in provider-dev/config/spec_pin.json.

# integration test registry copy (rebuilt every run)
tests/integration/.registry-tmp/
/.stackql
